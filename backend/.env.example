# ─────────────────────────────────────────────────────────────────────────────
# KodiPay Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── Allowed CORS Origins (comma-separated) ───────────────────────────────────
# For Flutter mobile: no origin restriction needed (handled by mobile CORS)
# For Flutter web build: add your web domain
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── JWT Secret — MUST be at least 32 random characters ───────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING

# ── Frontend URL (for password reset / invite links) ─────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
# For PostgreSQL on Render/Railway/Supabase:
DATABASE_URL=postgres://user:password@host:5432/kodipay

# ── M-Pesa Configuration ──────────────────────────────────────────────────────
MPESA_ENV=production
MPESA_CONSUMER_KEY=YOUR_MPESA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_MPESA_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_SHORTCODE
MPESA_PASSKEY=YOUR_MPESA_PASSKEY

# ── Stripe Configuration ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_LIVE_KEY
# Get from Stripe Dashboard → Webhooks → Add endpoint → Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SIGNING_SECRET

# ── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+254XXXXXXXXX

# ── Cloudinary (Image Storage) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-app-email@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_NAME=KodiPay

# ── Google Auth (for Google SSO) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ── Gemini AI (server-side only — never expose to client) ────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
